{
  "corpus_id": "polaris.phase00.w3.declassification-corpus",
  "corpus_version": "1.0.0",
  "purpose": "Representative missions prepared in W3 for the W4 declassification study. W3 records EXPECTATIONS only.",
  "measurement_status": "NOT_MEASURED",
  "measurement_note": "D1 and D2 do not exist yet. This corpus deliberately contains no burden metric, no mean, no percentile and no success rate. Any such number would be fabricated.",
  "vocabularies": {
    "expected_trust": [
      "TRUSTED",
      "UNTRUSTED"
    ],
    "expected_taint": [
      "UNTRUSTED_WEB",
      "UNTRUSTED_EMAIL",
      "UNTRUSTED_FILE",
      "MODEL_GENERATED",
      "USER_SUPPLIED",
      "SYSTEM_DERIVED"
    ],
    "expected_approval_need": [
      "NONE",
      "USER_CONFIRMATION",
      "OPERATOR"
    ],
    "expected_policy_outcome": [
      "ALLOW",
      "DENY"
    ],
    "w4_probe": [
      "NONE",
      "D1",
      "D2",
      "BOTH"
    ]
  },
  "missions": [
    {
      "mission_id": "M01",
      "title": "Read a file the user picked in the app",
      "category": "local_file_read",
      "narrative": "The user selects a file inside the project root and asks for its contents.",
      "inputs": [
        {
          "source": "USER_SELECTED_PATH",
          "expected_trust": "TRUSTED",
          "expected_taint": []
        }
      ],
      "candidate_declassifier": "NONE_REQUIRED",
      "expected_action_effects": [
        "read.filesystem"
      ],
      "expected_approval_need": "NONE",
      "expected_policy_outcome": "ALLOW",
      "w4_probe": "NONE",
      "w3_evaluable": true,
      "w3_case": {
        "kind": "read",
        "path": "D:\\POLARIS\\README.md",
        "declared": true,
        "confined": true
      }
    },
    {
