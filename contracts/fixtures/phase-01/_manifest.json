{
  "positive": [
    {
      "file": "bootstrap.request.json",
      "operation": "desktop.bootstrap",
      "direction": "REQUEST",
      "claim": "bootstrap takes no parameters and the empty object is closed"
    },
    {
      "file": "bootstrap.result.json",
      "operation": "desktop.bootstrap",
      "direction": "RESULT",
      "claim": "the whole Phase-01 snapshot, with an unattached runtime stated as such"
    },
    {
      "file": "capability-availability.request.json",
      "operation": "desktop.capability.availability",
      "direction": "REQUEST",
      "claim": "a bounded, explicit capability query"
    },
    {
      "file": "capability-availability.result.json",
      "operation": "desktop.capability.availability",
      "direction": "RESULT",
      "claim": "one entry per capability asked about, available and unavailable alike"
    },
    {
      "file": "runtime-status.request.json",
      "operation": "desktop.runtime.status",
      "direction": "REQUEST",
      "claim": "runtime status takes no parameters"
    },
    {
      "file": "runtime-status.result.json",
      "operation": "desktop.runtime.status",
      "direction": "RESULT",
      "claim": "reachability, availability and the observation instant"
    },
    {
      "file": "settings-describe.request.json",
      "operation": "desktop.settings.describe",
      "direction": "REQUEST",
      "claim": "a description restricted to named sections"
    },
    {
      "file": "settings-describe.result.json",
      "operation": "desktop.settings.describe",
      "direction": "RESULT",
      "claim": "structure and mode only, with an unavailable section carrying its reason"
    },
    {
      "file": "settings-read.request.json",
      "operation": "desktop.settings.read",
      "direction": "REQUEST",
      "claim": "a read bounded to one section"
    },
    {
      "file": "settings-read.result.json",
      "operation": "desktop.settings.read",
      "direction": "RESULT",
      "claim": "display-safe values, and a secret-bearing setting reported as configured with no value"
    }
  ],
  "negative": [
    {
      "file": "bootstrap.result.invalid-direction.json",
      "operation": "desktop.bootstrap",
