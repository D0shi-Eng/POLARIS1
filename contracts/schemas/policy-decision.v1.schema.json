{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PolicyDecisionV1",
  "description": "The PDP verdict for one invocation. Binary result plus typed obligations; approval is an obligation, never a third result.",
  "$comment": "النتيجة ثنائية فقط. REQUIRE_APPROVAL التزام وليس نتيجة، حتى لا يوجد تمثيل مزدوج للموافقة.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_id",
    "invocation_id",
    "correlation_id",
    "result",
    "obligations",
    "reason_codes",
    "display_reason",
    "policy_ref",
    "cacheability",
    "decided_at"
  ],
  "properties": {
    "contract_version": {
      "$ref": "./common/ids.schema.json#/$defs/ContractVersion"
    },
    "decision_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "invocation_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "correlation_id": {
      "$ref": "./common/ids.schema.json#/$defs/CorrelationId"
    },
    "causation_id": {
      "$ref": "./common/ids.schema.json#/$defs/CausationId"
    },
    "result": {
      "type": "string",
      "enum": [
        "ALLOW",
        "DENY"
      ]
    },
    "obligations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/Obligation"
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "DEFAULT_DENY",
          "NO_MATCHING_RULE",
          "EFFECT_NOT_GRANTED",
          "RISK_CLASS_EXCEEDED",
          "UNTRUSTED_CALLER",
          "TAINTED_INPUT",
          "NETWORK_NOT_BROKERED",
          "RATE_LIMIT",
          "APPROVAL_REQUIRED",
          "EXPLICIT_ALLOW_RULE",
          "USER_CONSENT_ON_FILE",
          "CONFIG_DEGRADED",
          "EVALUATION_ERROR",
          "RESOURCE_OUT_OF_SCOPE"
        ]
      }
    },
    "display_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Safe for any trust tier. Never contains rule bodies or policy internals."
    },
    "internal_reason": {
      "type": "string",
      "maxLength": 4096,
      "description": "Rule-level detail. Withheld from TIER_2_UNTRUSTED callers by the disclosure gate, not by this schema."
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "policy_epoch"
      ],
      "properties": {
        "policy_version": {
          "$ref": "./common/ids.schema.json#/$defs/SemVer"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cacheability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cacheable"
      ],
      "properties": {
        "cacheable": {
          "type": "boolean",
          "description": "false whenever the decision depended on invocation arguments or resource values."
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "invalidated_by_policy_epoch": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "cacheable": {
                "const": true
              }
            },
            "required": [
              "cacheable"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "ttl_seconds",
              "invalidated_by_policy_epoch"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "ttl_seconds"
                  ]
                },
                {
                  "type": "object",
                  "required": [
                    "invalidated_by_policy_epoch"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "decided_at": {
      "$ref": "./common/ids.schema.json#/$defs/Timestamp"
    }
  },
  "allOf": [
    {
      "$comment": "قرار الرفض لا يجوز أن يحمل التزامات تمنح امتيازًا. يُسمح بالتدقيق فقط.",
      "if": {
        "type": "object",
        "properties": {
          "result": {
            "const": "DENY"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "AUDIT"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "Obligation": {
      "title": "Obligation",
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "REQUIRE_APPROVAL"
            },
            "approver": {
              "type": "string",
              "enum": [
                "END_USER",
                "OPERATOR"
              ]
            },
            "expires_in_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "requirements"
          ],
          "properties": {
            "type": {
              "const": "REQUIRE_CONFINEMENT"
            },
            "requirements": {
              "$ref": "./common/execution.schema.json#/$defs/ExecutionRequirements"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "paths"
          ],
          "properties": {
            "type": {
              "const": "RESTRICT_FILESYSTEM"
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "./common/effect.schema.json#/$defs/ResourceRef"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "PROHIBIT_NETWORK"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "allowed_destinations"
          ],
          "properties": {
            "type": {
              "const": "REQUIRE_BROKERED_EGRESS"
            },
            "allowed_destinations": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "$ref": "./common/effect.schema.json#/$defs/NetworkDestination"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "level"
          ],
          "properties": {
            "type": {
              "const": "AUDIT"
            },
            "level": {
              "type": "string",
              "enum": [
                "STANDARD",
                "DETAILED"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "pointers"
          ],
          "properties": {
            "type": {
              "const": "REDACT"
            },
            "pointers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 512
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "max_bytes"
          ],
          "properties": {
            "type": {
              "const": "MAX_BYTES"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            }
          }
        }
      ]
    }
  }
}
