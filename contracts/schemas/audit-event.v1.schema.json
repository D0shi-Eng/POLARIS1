{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEventV1",
  "description": "A causal, replayable record. Not a log line: every event names its actor, its cause and the decision that authorised it.",
  "$comment": "حدث سببي قابل لإعادة التشغيل والتحقق. لا أسرار، لا حمولة حرة بلا نسخة.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "event_id",
    "event_type",
    "correlation_id",
    "occurred_at",
    "sequence",
    "actor",
    "caller_identity",
    "outcome"
  ],
  "properties": {
    "contract_version": {
      "$ref": "./common/ids.schema.json#/$defs/ContractVersion"
    },
    "event_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "IPC_MESSAGE_RECEIVED",
        "CAPABILITY_DESCRIBED",
        "INVOCATION_REQUESTED",
        "POLICY_EVALUATED",
        "APPROVAL_REQUESTED",
        "APPROVAL_RESOLVED",
        "EXECUTION_STARTED",
        "EXECUTION_COMPLETED",
        "MODEL_OUTPUT_VALIDATED",
        "CONTRACT_VIOLATION_DETECTED",
        "MISSION_STARTED",
        "MISSION_COMPLETED",
        "MISSION_FAILED",
        "CAPABILITY_PROPOSED",
        "APPROVAL_REQUIRED",
        "APPROVAL_PRESENTED",
        "APPROVAL_GRANTED",
        "APPROVAL_REJECTED",
        "APPROVAL_EXPIRED",
        "APPROVAL_REPLAY_REFUSED",
        "EXECUTION_GRANT_ISSUED",
        "PANIC_STOP_REQUESTED",
        "PANIC_STOP_ENTERED",
        "EXECUTOR_TERMINATED_BY_STOP",
        "PANIC_STOP_COMPLETED",
        "SYSTEM_RESUMED",
        "COMPLETION_PROOF_CREATED",
        "COMPLETION_PROOF_FAILED"
      ],
      "$comment": "1.1 أضاف مفردات W5: دورة حياة المهمة، والموافقة الموثوقة، وإصدار المنحة، وإيقاف الطوارئ، وإثبات الإنجاز. إضافة قيم enum تغيير إضافي: مستندات 1.0 تبقى صالحة."
    },
    "correlation_id": {
      "$ref": "./common/ids.schema.json#/$defs/CorrelationId"
    },
    "causation_id": {
      "$ref": "./common/ids.schema.json#/$defs/CausationId"
    },
    "occurred_at": {
      "$ref": "./common/ids.schema.json#/$defs/Timestamp"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per correlation_id. Breaks timestamp ties so ordering is total and hash chaining is well-defined."
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "CORE",
            "AGENT",
            "USER",
            "PLUGIN",
            "SYSTEM"
          ]
        },
        "id": {
          "$ref": "./common/ids.schema.json#/$defs/Uuid"
        }
      },
      "description": "The component that performed the action. Distinct from caller_identity, which is who asked for it."
    },
    "caller_identity": {
      "$ref": "./common/caller-identity.schema.json#/$defs/CallerIdentity"
    },
    "mission_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "agent_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "capability_version"
      ],
      "properties": {
        "capability_id": {
          "$ref": "./common/ids.schema.json#/$defs/Slug"
        },
        "capability_version": {
          "$ref": "./common/ids.schema.json#/$defs/SemVer"
        }
      }
    },
    "invocation_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "decision_id": {
      "$ref": "./common/ids.schema.json#/$defs/Uuid"
    },
    "effects": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "./common/effect.schema.json#/$defs/Effect"
      }
    },
    "resource": {
      "$ref": "./common/effect.schema.json#/$defs/ResourceRef"
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "SUCCESS",
            "DENIED",
            "FAILED",
            "TIMEOUT",
            "CANCELLED"
          ]
        },
        "error": {
          "$ref": "./common/error.schema.json#/$defs/ContractError"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "FAILED",
                  "TIMEOUT",
                  "DENIED"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "error"
            ]
          },
          "else": {
            "not": {
              "type": "object",
              "required": [
                "error"
              ]
            }
          }
        }
      ]
    },
    "policy_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_version",
        "policy_epoch"
      ],
      "properties": {
        "policy_version": {
          "$ref": "./common/ids.schema.json#/$defs/SemVer"
        },
        "policy_epoch": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "./common/provenance.schema.json#/$defs/ProvenanceRef"
      }
    },
    "metadata": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "$ref": "./common/ids.schema.json#/$defs/Slug"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      },
      "description": "Bounded, string-only, slug-keyed. Secret-bearing keys and values are rejected by the audit hygiene rule (INV-007), which this schema alone cannot express."
    },
    "integrity": {
      "$ref": "./common/provenance.schema.json#/$defs/Integrity"
    }
  },
  "allOf": [
    {
      "$comment": "حدث تقييم السياسة يجب أن يشير إلى القرار والاستدعاء.",
      "if": {
        "type": "object",
        "properties": {
          "event_type": {
            "const": "POLICY_EVALUATED"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "decision_id",
          "invocation_id"
        ]
      }
    },
    {
      "$comment": "أحداث الموافقة وإصدار المنحة يجب أن تسمّي القرار والاستدعاء اللذين تنتمي إليهما.",
      "if": {
        "type": "object",
        "properties": {
          "event_type": {
            "enum": [
              "APPROVAL_REQUIRED",
              "APPROVAL_PRESENTED",
              "APPROVAL_GRANTED",
              "APPROVAL_REJECTED",
              "APPROVAL_EXPIRED",
              "APPROVAL_REPLAY_REFUSED",
              "EXECUTION_GRANT_ISSUED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "decision_id",
          "invocation_id"
        ]
      }
    },
    {
      "$comment": "دورة حياة المهمة وإثبات الإنجاز يجب أن تسمّي المهمة.",
      "if": {
        "type": "object",
        "properties": {
          "event_type": {
            "enum": [
              "MISSION_STARTED",
              "MISSION_COMPLETED",
              "MISSION_FAILED",
              "COMPLETION_PROOF_CREATED",
              "COMPLETION_PROOF_FAILED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "mission_id"
        ]
      }
    },
    {
      "$comment": "أحداث التنفيذ يجب أن تربط الاستدعاء بالقدرة.",
      "if": {
        "type": "object",
        "properties": {
          "event_type": {
            "enum": [
              "EXECUTION_STARTED",
              "EXECUTION_COMPLETED"
            ]
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "invocation_id",
          "capability_ref"
        ]
      }
    }
  ]
}
