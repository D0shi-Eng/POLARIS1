{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "build-tests",
    "rootDir": ".",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "verbatimModuleSyntax": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests"
  ],
  "exclude": [
    "vite.config.ts",
    "src/main.tsx",
    "src/ipc/tauri-transport.ts",
    "src/e2e/run.ts"
  ]
}
